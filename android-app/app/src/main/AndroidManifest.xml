<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No permissions are requested on purpose: the app works only with the user's own pantry
        and recipes. It uses no location, GPS, maps or network services.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantry">

        <!-- Screen 1: Pantry list (launcher) -->
        <activity
            android:name=".ui.PantryListActivity"
            android:exported="true"
            android:label="@string/title_pantry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Add / edit ingredient -->
        <activity
            android:name=".ui.AddEditIngredientActivity"
            android:exported="false"
            android:label="@string/title_add_ingredient"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 3: Suggested recipes (strict matching) -->
        <activity
            android:name=".ui.SuggestedRecipesActivity"
            android:exported="false"
            android:label="@string/title_cook" />

        <!-- Screen 4: Recipe detail -->
        <activity
            android:name=".ui.RecipeDetailActivity"
            android:exported="false"
            android:label="@string/title_recipe" />

        <!-- Screen 5: Settings -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />
    </application>
</manifest>
